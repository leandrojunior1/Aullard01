#include <stdio.h>

int main() {
    
    float nota_1, nota_2, freq, media;
    printf("Digite a primeira nota: ");
    scanf("%f", &nota_1);
    printf("Digite a segunda nota: ");
    scanf("%f", &nota_2);
    printf("Digite a frequência do aluno: ");
    scanf("%.2f", &freq);

    media = (nota_1 + nota_2) / 2.0f;

    printf("Media: %.2f\n", media);

    if (media >= 6.00 && freq >= 75.00) {
        printf("Aprovado!");
    } else {
        printf("Reprovado!");
    }
        
    return 0;
}
