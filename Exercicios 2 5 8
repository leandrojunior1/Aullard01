#include <stdio.h>

int main() {
    int numero;
    printf("Digite 0 para sair!");
    scanf("d%", &numero);
    while (numero != 0)	{
        printf("Voce digitou: %d\n", numero);

        printf("Digite outro numero ou 0 para sair: ");
        scanf("%d", &numero);
    }
    printf("Programa encerrado! Até logo.\n");
    return 0;
}
